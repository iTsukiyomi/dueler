# PokemonDuel — Environment Configuration
# Copy this file to .env and fill in your values.

# Discord bot token (required)
DISCORD_TOKEN=your_discord_bot_token_here


MONGO_URI=mongo_url
MONGO_DB_NAME=name

# Redis connection string (optional — bot works without it, just slower)
# Free tier: https://redis.io/try-free/
REDIS_URL=redis

# Discord OAuth2 — web dashboard (create app at discord.com/developers)
DISCORD_CLIENT_ID=your_discord_oauth2_client_id
DISCORD_CLIENT_SECRET=your_discord_oauth2_client_secret
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/callback

# JWT secret for web sessions (min 32 chars)
JWT_SECRET=a_long_random_secret_32_chars_minimum

# Web server config
API_PORT=3001
FRONTEND_URL=http://localhost:5173
